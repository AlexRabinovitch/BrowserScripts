// ==UserScript==
// @name         oper.ru filter
// @namespace    https://tampermonkey.net/
// @version      0.1
// @description  Removes unwanted items
// @author       Alex Rabinovitch
// @match        https://oper.ru/*
// @require      http://code.jquery.com/jquery-latest.js
// @require      https://gist.github.com/raw/2625891/waitForKeyElements.js
// @run-at       document-start
// @grant        none
// ==/UserScript==

var _filters = new Object();

(function() {
    'use strict';

    try
    {
        fillFilters();
    }
    catch(e)
    {
        console.log('oper.ru filter error: ' + e.message);
    }
})();

new MutationObserver(function(mutations)
{
    console.log('Mutations detected: ' + mutations.length);

    for (var i = 0; i < mutations.length; i++)
    {
        var mutationAddedNodes = mutations[i].addedNodes;
        for (var j = 0; j < mutationAddedNodes.length; j++)
        {
            var node = mutationAddedNodes[j];
            //if (node.tagName && node.tagName.toUpperCase() == "DT")
            if (node.tagName && node.tagName.toUpperCase() == "ARTICLE")
            {
                console.log('Node found');
                processNode(node);
            }
        }
    }

}).observe(document, {childList: true, subtree: true});

document.onreadystatechange = () =>
{
    if (document.readyState === 'complete')
    {
        console.log('Document ready');

        //var nodes = document.querySelectorAll('dt');
        var nodes = document.querySelectorAll('article.newsitem');

        console.log('Nodes length: ' + nodes.length);

        for(var i = 0; i < nodes.length; i++)
        {
            processNode(nodes[i]);
        }
    }
};

function processNode(newsNode)
{
    var isAllowed = checkHeader(newsNode);

    console.log('isAllowed: ' + isAllowed);
    if(isAllowed == "true")
    {
        return;
    }
    else if(isAllowed == "false")
    {
        newsNode.remove();
        return;
    }

    if(!checkMeta(newsNode))
    {
        console.log('Going to check meta...');
        newsNode.remove();
        return;
    }

    console.log('Going to check body...');
    if(!checkBody(newsNode))
    {
        console.log('Going to remove article...');
        newsNode.remove();
        return;
    }
}

function getHeader(newsNode)
{
    var headerNodes = newsNode.querySelectorAll('h1');

    if (headerNodes)
    {
        console.log('Header node found');

        return headerNodes[0];
    }
    console.log('Header node not found');
    return null;
}

function getBody(newsNode)
{
    var bodyNodes = newsNode.querySelectorAll('div.newsbody');

    if (bodyNodes)
    {
        console.log('Body node found');

        return bodyNodes[0];
    }
    console.log('Body node not found');
    return null;
}

function getMeta(newsNode)
{
    var metaNodes = newsNode.querySelectorAll('p.meta');

    if (metaNodes)
    {
        console.log('Meta node found');

        return metaNodes[0];
    }
    console.log('Meta node not found');
    return null;
}

function checkHeader(newsNode)
{
    var header = getHeader(newsNode);
    var titles = header.querySelectorAll('a');
    var title = '';
    if(titles && titles.length > 0)
    {
        title = titles[0].innerText;
        console.log('Title found: ' + title);

        var regex = new RegExp(_filters.AlwaysBlock.Headers.join("|"), 'i');
        //console.log('regex: ' + regex);

        if(regex.test(title))
        {
            console.log('Header to block found: ' + title);
            return "false";
        }

        regex = new RegExp(_filters.AlwaysAllow.Headers.join("|"), 'i');
        if(regex.test(title))
        {
            return "true";
        }
    }
    console.log('Title not found');
    return "unknown";
}

function checkMeta(newsNode)
{
    try
    {
        var metaNode = getMeta(newsNode);
        var items = metaNode.querySelectorAll('a.comments');

        if(items && items.length > 0)
        {
            for(var i = 0; i < items.length; i++)
            {
                var item = items[i];
                var itemText = $(item).text();
                console.log('itemText: ' + itemText);

                if(checkItemText(itemText, _filters.AlwaysBlock.Users))
                {
                    return false;
                }
                if(checkItemText(itemText, _filters.AlwaysBlock.Topics))
                {
                    return false;
                }
                if(checkItemText(itemText, _filters.AlwaysAllow.Users))
                {
                    return true;
                }
            }
        }
    }
    catch(e)
    {
        console.log('Error: ' + e.message);
    }
    return true;
}

function checkBody(newsNode)
{
    try
    {
        var bodyNode = getBody(newsNode);
        var links = bodyNode.querySelectorAll('a');
        var link = '';
        if(links && links.length > 0)
        {
            for(var i = 0; i < links.length; i++)
            {
                link = links[i].innerText;
                console.log('Link found: ' + link);

                var regex = new RegExp(_filters.AlwaysBlock.Keywords.join("|"), 'i');
                //console.log('regex: ' + regex);

                if(regex.test(link))
                {
                    console.log('Link to block found: ' + link);
                    return false;
                }

                regex = new RegExp(_filters.AlwaysAllow.Keywords.join("|"), 'i');
                if(regex.test(link))
                {
                    return true;
                }
            }
        }
    }
    catch(e)
    {
        console.log('Error: ' + e.message);
    }
    return true;
}

function checkItemText(itemText, filterValues)
{
    for(var i = 0; i < filterValues.length; i++)
    {
        if(itemText == filterValues[i])
        {
            return true;
        }
    }
}

function fillFilters()
{
    console.log('Filling filters...');

    var alwaysAllow = new Object();
    alwaysAllow.Headers = ['Егор.*?Яковлев', '^(?!.*?Breaking Bad)(?!.*?Реми Майснер).*?Клим.*?Жуков', 'Владимир.*?Неволин', 'Синий Фил', 'Шемякин'];
    alwaysAllow.Users = ['egoryakovlev', 'Zhukoff'];
    alwaysAllow.Keywords = ['Шекспир плачет'];
    _filters.AlwaysAllow = alwaysAllow;

    var alwaysBlock = new Object();
    alwaysBlock.Headers = ['Надан.*?Фридрихсон', 'Вероник.*?Крашенинников', 'Во все тяжкие', 'Breaking Bad', 'Позывной ', 'Помощь детям .*Донецка', 'Реми Майснер', 'Михаил.*?Фадее', 'Зулейха', 'Эффект Доплера', 'Арктик', 'Солженицын', 'в переводе Гоблина', 'Вечерний Излучатель', 'Победитель конкурса', 'Приз получает', 'Ремня получает', 'арктич', 'vip\.oper\.ru', 'Слово пацана', 'Внеклассовое чтение', 'ДНР', 'Goblin news', 'Sputnik', 'Новороссия', 'Штрафбат', 'The Last of Us', 'Лихие', 'радио Спутник', 'Цветаев', 'Раздача призов', 'Розыгрыш', 'Ольга Ускова', 'Гельтек', 'дяд.*?Вов', 'Демография', 'Турнир.*?Святого Георгия', 'русск.*? революц', 'Сем.*?Уралов', 'Трамп', 'снакци'];
    alwaysBlock.Users = ['redacteur', 'Redakteur', 'Onepamop', 'реклама'];
    alwaysBlock.Topics = ['Это ПЕАР', 'Железки', 'СВО', 'Политика', 'Победа!', 'Образование'];
    alwaysBlock.Keywords = ['Арктик', 'vip\.oper\.ru'];//'Уралов', '^Скидка', '^Распродажа',
    _filters.AlwaysBlock = alwaysBlock;

    console.log('Done filling filters.');
}
